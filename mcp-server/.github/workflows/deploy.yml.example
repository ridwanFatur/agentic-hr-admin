name: MCP Server Deploy

on:
  push:
    branches:
      - master

jobs:
  deploy:
    name: Build, Push, and Deploy MCP Server
    runs-on: ubuntu-latest

    steps:
      # ── 1. Checkout ────────────────────────────────────────────────────────
      - name: Checkout repository
        uses: actions/checkout@v4

      # ── 2. Authenticate to Google Cloud ────────────────────────────────────
      - name: Authenticate to Google Cloud
        uses: google-github-actions/auth@v2
        with:
          credentials_json: ${{ secrets.GCP_SA_KEY }}

      # ── 3. Set up gcloud CLI ────────────────────────────────────────────────
      - name: Set up gcloud CLI
        uses: google-github-actions/setup-gcloud@v2

      # ── 4. Configure Docker for Artifact Registry ───────────────────────────
      - name: Configure Docker for Artifact Registry
        run: gcloud auth configure-docker us-central1-docker.pkg.dev --quiet

      # ── 5. Build and push Docker image ──────────────────────────────────────
      - name: Build and push Docker image
        env:
          IMAGE: us-central1-docker.pkg.dev/${{ secrets.GCP_PROJECT_ID }}/${{ secrets.GAR_REPO_NAME }}/mcp-server
        run: |
          docker build \
            --tag "$IMAGE:${{ github.sha }}" \
            --tag "$IMAGE:latest" \
            .

          docker push "$IMAGE:${{ github.sha }}"
          docker push "$IMAGE:latest"

      # ── 6. Generate short-lived Docker auth token ────────────────────────────
      - name: Generate Docker auth token
        id: docker_token
        run: |
          TOKEN=$(gcloud auth print-access-token)
          echo "::add-mask::$TOKEN"
          echo "token=$TOKEN" >> "$GITHUB_OUTPUT"

      # ── 7. SSH into VM, pull image, and restart container ───────────────────
      - name: Deploy to VM
        uses: appleboy/ssh-action@v1.0.3
        env:
          IMAGE: us-central1-docker.pkg.dev/${{ secrets.GCP_PROJECT_ID }}/${{ secrets.GAR_REPO_NAME }}/mcp-server:${{ github.sha }}
          DOCKER_TOKEN: ${{ steps.docker_token.outputs.token }}
          DATABASE_URL: ${{ secrets.DATABASE_URL }}
        with:
          host: ${{ secrets.VM_IP }}
          username: ${{ secrets.SSH_USER }}
          key: ${{ secrets.SSH_PRIVATE_KEY }}
          envs: IMAGE,DOCKER_TOKEN,DATABASE_URL
          script: |
            set -e

            # Authenticate Docker on the VM using the short-lived token
            echo "$DOCKER_TOKEN" | docker login \
              -u oauth2accesstoken \
              --password-stdin \
              https://us-central1-docker.pkg.dev

            # Pull the new image
            docker pull "$IMAGE"

            # Write env file (DATABASE_URL only)
            mkdir -p "$HOME/mcp-server"
            cat > "$HOME/mcp-server/.env" <<EOF
            DATABASE_URL=${DATABASE_URL}
            EOF
            chmod 600 "$HOME/mcp-server/.env"

            # Stop and remove the old container (safe to fail if not running)
            docker stop mcp-server || true
            docker rm   mcp-server || true

            # Start new container
            docker run -d \
              --name mcp-server \
              --restart unless-stopped \
              --env-file "$HOME/mcp-server/.env" \
              -p 8001:8001 \
              "$IMAGE"

            # Remove dangling images to reclaim disk space
            docker image prune -f
